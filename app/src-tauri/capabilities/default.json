{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"] },
  "permissions": [
    "core:default",
    "allow-restart-app",
    "allow-close-popups",
    "allow-app-version",
    "allow-update-check",
    "allow-update-progress",
    "allow-update-install"
  ]
}
